# ============================================================================
# ZOTAIX — environment template
# ----------------------------------------------------------------------------
# Copy to .env.local (Next.js) or configure in your hosting dashboard.
# EVERY variable is optional: each integration degrades to a designed
# fallback when unset, so the platform is fully functional out of the box.
# The graceful fallback per group is stated below (see also src/lib/config.ts
# integrationStatus() and the /admin/integrations panel).
# ============================================================================

# ----------------------------------------------------------------------------
# Core platform
# ----------------------------------------------------------------------------
# Fallback when unset: seeded in-memory store (db/schema.sql + db/seed.sql
# mirrored in src/lib/seed.ts; state resets per deployment instance) and a
# development session secret.

# Postgres / Supabase connection string. Apply db/schema.sql then db/seed.sql
# before pointing the app here.
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Canonical public URL of the deployment (no trailing slash). Used for
# metadata, OG images, share links, and the app wrapper.
# Example: https://zotaix-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# Random string (32+ chars) used to sign session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ----------------------------------------------------------------------------
# AI providers
# ----------------------------------------------------------------------------
# Fallback when unset: the deterministic ZOTAIX Atelier engine generates
# structured proposals locally — every concierge mode keeps working.

# Preferred provider when both keys are present: "anthropic" | "openai".
AI_PROVIDER=

# OpenAI credentials + model override (model defaults are set in code).
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic credentials + model override.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ----------------------------------------------------------------------------
# Payments
# ----------------------------------------------------------------------------
# Fallback when unset: orders are recorded in test mode or routed to human
# concierge confirmation (status "awaiting_concierge") — no payment is taken
# and nothing is promised beyond the concierge follow-up.

# Stripe (card payments, international).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WeChat Pay merchant credentials (mainland China).
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=

# Alipay open-platform app credentials (mainland China).
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# PayPal REST credentials (international).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ----------------------------------------------------------------------------
# WeChat Official Account
# ----------------------------------------------------------------------------
# Fallback when unset: /wechat shows the QR display and configuration
# preview; menu and auto-reply settings are stored and ready to publish once
# credentials arrive.

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ----------------------------------------------------------------------------
# Storage / CDN
# ----------------------------------------------------------------------------
# Fallback when unset: local /public assets and generated SVG/PNG imagery
# (QRCodeBox marks, /api/card, /api/og) serve all visuals.

# Object storage bucket for uploaded media (e.g. Supabase Storage or S3).
STORAGE_BUCKET=

# Public CDN base URL for stored assets (no trailing slash).
CDN_URL=

# ----------------------------------------------------------------------------
# Operations
# ----------------------------------------------------------------------------
# Fallback when unset: admin identity defaults to the seeded operations
# account (admin@zotaix.demo).

# Email of the operations/admin account.
ADMIN_EMAIL=

# ----------------------------------------------------------------------------
# App distribution
# ----------------------------------------------------------------------------
# Fallback when unset: /download presents the PWA install flow as the primary
# path; store buttons appear as soon as a URL is set here or via the admin
# app-config panel. See docs/APP_PACKAGING.md.

# App Store listing URL, e.g. https://apps.apple.com/app/id0000000000
APP_IOS_URL=

# Google Play listing URL, e.g. https://play.google.com/store/apps/details?id=com.zotaix.app
APP_ANDROID_URL=

# Direct APK download URL for regions without Play access.
APP_APK_URL=
